---
import { Icon } from 'astro-icon/components';

interface Props {
  eyebrow?: string;
  title: string;
  subheadline?: string;
  ctaHref?: string;
  ctaLabel?: string;
  secondaryHref?: string;
  secondaryLabel?: string;
  compact?: boolean;
}

const { eyebrow, title, subheadline, ctaHref, ctaLabel, secondaryHref, secondaryLabel, compact = false } = Astro.props;
---

<section class:list={['overflow-hidden rounded-3xl border border-slate-200 bg-white px-8 py-12 text-slate-900 shadow-sm sm:px-10 lg:px-14 lg:py-16', compact ? 'py-10 lg:py-12' : 'py-12 lg:py-16']}>
  <div class="flex flex-col gap-6">
    {eyebrow && <p class="text-sm font-semibold uppercase tracking-[0.24em] text-slate-500">{eyebrow}</p>}
    <h1 class="max-w-3xl text-4xl font-semibold tracking-tight sm:text-5xl">{title}</h1>
    {subheadline && <p class="max-w-2xl text-lg leading-8 text-slate-600">{subheadline}</p>}
    {(ctaHref || secondaryHref) && (
      <div class="flex flex-wrap gap-3">
        {ctaHref && (
          <a href={ctaHref} class="btn-primary inline-flex items-center gap-2 rounded-full px-5 py-3">
            <span>{ctaLabel || 'Book a free consultation'}</span>
            <Icon name="heroicons:arrow-right" class="h-4 w-4" aria-hidden="true" />
          </a>
        )}
        {secondaryHref && (
          <a href={secondaryHref} class="rounded-full border border-slate-300 bg-slate-50 px-5 py-3 font-semibold text-slate-700 no-underline hover:bg-slate-100">
            {secondaryLabel || 'Explore more'}
          </a>
        )}
      </div>
    )}
  </div>
</section>
