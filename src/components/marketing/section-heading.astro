---
interface Props {
  eyebrow?: string;
  title: string;
  intro?: string;
  align?: 'left' | 'center';
}

const { eyebrow, title, intro, align = 'left' } = Astro.props;
---

<div class:list={['flex flex-col gap-3', align === 'center' ? 'items-center text-center' : 'items-start text-left']}>
  {eyebrow && <p class="text-sm font-semibold uppercase tracking-[0.24em] text-slate-500 dark:text-slate-400">{eyebrow}</p>}
  <h2 class="text-3xl font-semibold text-slate-900 sm:text-4xl dark:text-white">{title}</h2>
  {intro && <p class="max-w-2xl text-lg leading-8 text-slate-600 dark:text-slate-300">{intro}</p>}
</div>
