---
import { Icon } from 'astro-icon/components';

interface Props {
  title: string;
  description: string;
  href: string;
  icon: string;
}

const { title, description, href, icon } = Astro.props;
---

<article class="flex h-full flex-col rounded-2xl border border-slate-200 bg-white p-6 shadow-sm transition-all hover:-translate-y-0.5 hover:border-slate-300 hover:shadow-md dark:border-slate-700 dark:bg-slate-900">
  <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-2xl bg-slate-100 text-slate-700 dark:bg-slate-800 dark:text-slate-200">
    <Icon name={icon} class="h-6 w-6" aria-hidden="true" />
  </div>
  <h3 class="text-xl font-semibold text-slate-900 dark:text-white">{title}</h3>
  <p class="mt-3 text-sm leading-7 text-slate-600 dark:text-slate-300">{description}</p>
  <a href={href} class="mt-6 inline-flex items-center gap-2 font-semibold text-slate-700 dark:text-slate-200">
    Learn more
    <span aria-hidden="true">→</span>
  </a>
</article>
