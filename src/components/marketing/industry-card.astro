---
interface Props {
  title: string;
  description: string;
  href: string;
  tag?: string;
}

const { title, description, href, tag } = Astro.props;
---

<a href={href} class="group flex h-full flex-col rounded-2xl border border-slate-200 bg-white p-6 shadow-sm transition-all hover:-translate-y-0.5 hover:border-slate-300 hover:shadow-md dark:border-slate-700 dark:bg-slate-900">
  {tag && <p class="mb-3 text-sm font-semibold uppercase tracking-[0.24em] text-slate-500 dark:text-slate-400">{tag}</p>}
  <h3 class="text-xl font-semibold text-slate-900 dark:text-white">{title}</h3>
  <p class="mt-3 text-sm leading-7 text-slate-600 dark:text-slate-300">{description}</p>
  <span class="mt-6 inline-flex items-center gap-2 font-semibold text-slate-700 dark:text-slate-200">
    View details
    <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">→</span>
  </span>
</a>
