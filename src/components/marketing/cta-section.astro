---
interface Props {
  title: string;
  body?: string;
  href?: string;
  label?: string;
}

const { title, body, href = '/contact', label = 'Book a free consultation' } = Astro.props;
---

<section class="rounded-3xl border border-slate-200 bg-slate-50 px-8 py-10 shadow-sm dark:border-slate-700 dark:bg-slate-900/60 sm:px-10 lg:px-14">
  <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
    <div class="max-w-2xl">
      <h2 class="text-3xl font-semibold text-slate-900 dark:text-white">{title}</h2>
      {body && <p class="mt-3 text-lg leading-8 text-slate-600 dark:text-slate-300">{body}</p>}
    </div>
    {href && (
      <a href={href} class="btn-primary inline-flex w-fit items-center gap-2 rounded-full">
        <span>{label}</span>
        <span aria-hidden="true">→</span>
      </a>
    )}
  </div>
</section>
