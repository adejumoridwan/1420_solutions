---
import Layout from "@layouts/default.astro";
import HeroSection from "@components/marketing/hero-section.astro";
import SectionHeading from "@components/marketing/section-heading.astro";
import CtaSection from "@components/marketing/cta-section.astro";

const challenges = [
  'Admissions, fees, and student records spread across disconnected systems.',
  'Staff HR and payroll processes that are too manual to scale.',
  'Timetable and resource planning that changes too often to manage in spreadsheets.',
  'Limited visibility into performance, compliance, and finance data.',
];

const modules = [
  ['Student Information Management', 'Admissions, student profiles, attendance, and academic records in one place.'],
  ['Fee & Billing', 'Tuition and fee collection workflows aligned to student records.'],
  ['HR & Payroll', 'Staff records, payroll, and leave management integrated with operations.'],
  ['Timetable & Resource Planning', 'Room, teacher, and resource scheduling tied to real availability.'],
];
---

<Layout title="Education Solutions" description="1420 Solutions helps education organizations implement ERPNext for student administration, fees, HR, and operations.">
  <div class="space-y-12 px-6 py-8 sm:px-8 lg:px-10 lg:py-10">
    <HeroSection
      eyebrow="Education solutions"
      title="Bring student administration, finance, and operations under one roof."
      subheadline="1420 Solutions configures ERPNext around the operational realities of schools, colleges, and training providers so administration becomes easier to manage and easier to report."
      ctaHref="/contact"
      ctaLabel="Request a demo"
    />

    <section class="rounded-3xl border border-stone-200 bg-white p-8 shadow-sm dark:border-stone-700 dark:bg-stone-900 sm:p-10 lg:p-12">
      <SectionHeading title="Key challenges we solve" intro="Education organizations need systems that keep student experience, staff operations, and finance data connected." />
      <ul class="mt-8 grid gap-4 md:grid-cols-2">
        {challenges.map((item) => (
          <li class="rounded-2xl border border-stone-200 bg-slate-50 p-5 text-sm leading-7 text-stone-700 dark:border-stone-700 dark:bg-stone-950 dark:text-stone-300">{item}</li>
        ))}
      </ul>
    </section>

    <section class="rounded-3xl border border-stone-200 bg-gradient-to-br from-slate-50 to-sky-50 p-8 shadow-sm dark:border-stone-700 dark:bg-stone-900 sm:p-10 lg:p-12">
      <SectionHeading title="What we implement" intro="We configure ERPNext education workflows to match how your school or institute operates." />
      <div class="mt-8 grid gap-6 md:grid-cols-2">
        {modules.map(([title, body]) => (
          <div class="rounded-2xl border border-stone-200 bg-white p-6 dark:border-stone-700 dark:bg-stone-950">
            <h3 class="text-lg font-semibold">{title}</h3>
            <p class="mt-2 text-sm leading-7 text-stone-600 dark:text-stone-300">{body}</p>
          </div>
        ))}
      </div>
    </section>

    <CtaSection title="Need a clearer way to run student and staff operations?" href="/contact" label="Book a free consultation" />
  </div>
</Layout>
