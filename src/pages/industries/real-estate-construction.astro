---
import Layout from "@layouts/default.astro";
import HeroSection from "@components/marketing/hero-section.astro";
import SectionHeading from "@components/marketing/section-heading.astro";
import CtaSection from "@components/marketing/cta-section.astro";

const challenges = [
  'Project delivery and budget tracking disconnected from site operations.',
  'Contractors and vendors tracked in ways that do not support fast decisions.',
  'Property or lease data spread across multiple tools and documents.',
  'Limited visibility into profitability, cost control, and delivery timelines.',
];

const modules = [
  ['Project & Site Management', 'Milestones, tasks, and site-level coordination tied to delivery goals.'],
  ['Budgeting & Cost Control', 'Forecasts, commitments, and cost tracking managed with operational clarity.'],
  ['Contractor & Vendor Management', 'Supplier and contractor coordination built around project needs.'],
  ['Property & Lease Tracking', 'Property lifecycle data and transaction information kept in one place.'],
];
---

<Layout title="Real Estate & Construction Solutions" description="1420 Solutions helps real estate and construction businesses implement ERPNext for project management, budgeting, and vendor coordination.">
  <div class="space-y-12 px-6 py-8 sm:px-8 lg:px-10 lg:py-10">
    <HeroSection
      eyebrow="Real estate & construction solutions"
      title="Keep projects, budgets, and vendors under control from site to close."
      subheadline="1420 Solutions configures ERPNext for construction and real estate operations so project teams can track delivery, cost, and commitments with less friction."
      ctaHref="/contact"
      ctaLabel="Request a demo"
    />

    <section class="rounded-3xl border border-stone-200 bg-white p-8 shadow-sm dark:border-stone-700 dark:bg-stone-900 sm:p-10 lg:p-12">
      <SectionHeading title="Key challenges we solve" intro="Real estate and construction teams need reliable control over project delivery and financial visibility." />
      <ul class="mt-8 grid gap-4 md:grid-cols-2">
        {challenges.map((item) => (
          <li class="rounded-2xl border border-stone-200 bg-slate-50 p-5 text-sm leading-7 text-stone-700 dark:border-stone-700 dark:bg-stone-950 dark:text-stone-300">{item}</li>
        ))}
      </ul>
    </section>

    <section class="rounded-3xl border border-stone-200 bg-gradient-to-br from-slate-50 to-sky-50 p-8 shadow-sm dark:border-stone-700 dark:bg-stone-900 sm:p-10 lg:p-12">
      <SectionHeading title="What we implement" intro="We design the core setup around project execution and financial control rather than isolated departmental admin." />
      <div class="mt-8 grid gap-6 md:grid-cols-2">
        {modules.map(([title, body]) => (
          <div class="rounded-2xl border border-stone-200 bg-white p-6 dark:border-stone-700 dark:bg-stone-950">
            <h3 class="text-lg font-semibold">{title}</h3>
            <p class="mt-2 text-sm leading-7 text-stone-600 dark:text-stone-300">{body}</p>
          </div>
        ))}
      </div>
    </section>

    <CtaSection title="Need stronger project and cost control?" href="/contact" label="Book a free consultation" />
  </div>
</Layout>
