---
import Layout from "@layouts/default.astro";
import HeroSection from "@components/marketing/hero-section.astro";
import SectionHeading from "@components/marketing/section-heading.astro";
import CtaSection from "@components/marketing/cta-section.astro";

const challenges = [
  'Double-booked rooms and manual housekeeping logs.',
  'Inventory and procurement data that does not reflect what the front desk is seeing.',
  'POS integration gaps that create reconciliation headaches.',
  'Multi-property operations that rely on too many disconnected tools.',
];

const modules = [
  ['Front Desk & Reservations', 'Room bookings, guest profiles, and check-in workflows aligned to operations.'],
  ['Housekeeping & Service Coordination', 'Task tracking and maintenance visibility across the property.'],
  ['Inventory & Procurement', 'Stock controls, purchasing workflows, and supplier management.'],
  ['POS Integration', 'Operational data flows between the property system and point of sale.'],
];
---

<Layout title="Hospitality Solutions" description="1420 Solutions helps hospitality businesses implement ERPNext for reservations, housekeeping, inventory, and multi-property operations.">
  <div class="space-y-12 px-6 py-8 sm:px-8 lg:px-10 lg:py-10">
    <HeroSection
      eyebrow="Hospitality solutions"
      title="Stop losing revenue to double-booked rooms and manual housekeeping logs."
      subheadline="1420 Solutions implements ERPNext for hospitality operations so front desk, housekeeping, procurement, and finance data all stay connected."
      ctaHref="/contact"
      ctaLabel="Request a demo"
    />

    <section class="rounded-3xl border border-stone-200 bg-white p-8 shadow-sm dark:border-stone-700 dark:bg-stone-900 sm:p-10 lg:p-12">
      <SectionHeading title="Key challenges we solve" intro="Hotels and hospitality groups need uptime, coordination, and visibility across the guest journey and the back office." />
      <ul class="mt-8 grid gap-4 md:grid-cols-2">
        {challenges.map((item) => (
          <li class="rounded-2xl border border-stone-200 bg-slate-50 p-5 text-sm leading-7 text-stone-700 dark:border-stone-700 dark:bg-stone-950 dark:text-stone-300">{item}</li>
        ))}
      </ul>
    </section>

    <section class="rounded-3xl border border-stone-200 bg-gradient-to-br from-slate-50 to-sky-50 p-8 shadow-sm dark:border-stone-700 dark:bg-stone-900 sm:p-10 lg:p-12">
      <SectionHeading title="What we implement" intro="We configure the core operations modules so each property can run with better visibility and less manual coordination." />
      <div class="mt-8 grid gap-6 md:grid-cols-2">
        {modules.map(([title, body]) => (
          <div class="rounded-2xl border border-stone-200 bg-white p-6 dark:border-stone-700 dark:bg-stone-950">
            <h3 class="text-lg font-semibold">{title}</h3>
            <p class="mt-2 text-sm leading-7 text-stone-600 dark:text-stone-300">{body}</p>
          </div>
        ))}
      </div>
    </section>

    <CtaSection title="Need a better operating system for your property?" href="/contact" label="Book a free consultation" />
  </div>
</Layout>
