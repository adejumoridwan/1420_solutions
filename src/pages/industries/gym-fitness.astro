---
import Layout from "@layouts/default.astro";
import HeroSection from "@components/marketing/hero-section.astro";
import SectionHeading from "@components/marketing/section-heading.astro";
import CtaSection from "@components/marketing/cta-section.astro";

const challenges = [
  'Memberships, billing, and attendance data spread across different tools.',
  'Class schedules and trainer availability managed manually.',
  'Renewals and subscriptions slipping because the process is too fragmented.',
  'Limited visibility into retention, utilization, and membership health.',
];

const modules = [
  ['Membership Management', 'Member profiles, renewals, and access management in one place.'],
  ['Class Scheduling', 'Classes, trainer assignments, and space allocation coordinated clearly.'],
  ['Billing & Subscriptions', 'Recurring invoices, payments, and member lifecycle flows.'],
  ['Trainer & Equipment Tracking', 'Capacity and asset usage tracked as part of the operating model.'],
];
---

<Layout title="Gym & Fitness Solutions" description="1420 Solutions helps gyms and fitness operators implement ERPNext for memberships, billing, scheduling, and operations.">
  <div class="space-y-12 px-6 py-8 sm:px-8 lg:px-10 lg:py-10">
    <HeroSection
      eyebrow="Gym & Fitness solutions"
      title="Run memberships, scheduling, and billing without manual follow-up."
      subheadline="1420 Solutions implements ERPNext for fitness businesses so memberships, classes, payments, and operations data stay connected and easier to manage."
      ctaHref="/contact"
      ctaLabel="Request a demo"
    />

    <section class="rounded-3xl border border-stone-200 bg-white p-8 shadow-sm dark:border-stone-700 dark:bg-stone-900 sm:p-10 lg:p-12">
      <SectionHeading title="Key challenges we solve" intro="Fitness operators need systems that support member experience and the back office without creating admin drag." />
      <ul class="mt-8 grid gap-4 md:grid-cols-2">
        {challenges.map((item) => (
          <li class="rounded-2xl border border-stone-200 bg-slate-50 p-5 text-sm leading-7 text-stone-700 dark:border-stone-700 dark:bg-stone-950 dark:text-stone-300">{item}</li>
        ))}
      </ul>
    </section>

    <section class="rounded-3xl border border-stone-200 bg-gradient-to-br from-slate-50 to-sky-50 p-8 shadow-sm dark:border-stone-700 dark:bg-stone-900 sm:p-10 lg:p-12">
      <SectionHeading title="What we implement" intro="We shape the core modules around the member journey, daily operations, and revenue processes that matter most." />
      <div class="mt-8 grid gap-6 md:grid-cols-2">
        {modules.map(([title, body]) => (
          <div class="rounded-2xl border border-stone-200 bg-white p-6 dark:border-stone-700 dark:bg-stone-950">
            <h3 class="text-lg font-semibold">{title}</h3>
            <p class="mt-2 text-sm leading-7 text-stone-600 dark:text-stone-300">{body}</p>
          </div>
        ))}
      </div>
    </section>

    <CtaSection title="Need a better rhythm for member operations?" href="/contact" label="Book a free consultation" />
  </div>
</Layout>
