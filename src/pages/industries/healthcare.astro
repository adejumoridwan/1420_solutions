---
import Layout from "@layouts/default.astro";
import HeroSection from "@components/marketing/hero-section.astro";
import SectionHeading from "@components/marketing/section-heading.astro";
import CtaSection from "@components/marketing/cta-section.astro";

const challenges = [
  'Patient records, billing, and insurance workflows managed in separate places.',
  'Inventory for pharmacy and medical supplies that is difficult to control precisely.',
  'Staff scheduling and compliance reporting that consumes too much administration time.',
  'Operational reporting that is too slow or too fragmented for decision-making.',
];

const modules = [
  ['Patient Records & Clinical Administration', 'Operational workflows around patient data, billing, and service delivery.'],
  ['Billing & Insurance Claims', 'Claims, billing, and follow-up processes aligned to finance operations.'],
  ['Inventory & Supply Management', 'Pharmacy and medical supply control tied to demand and replenishment.'],
  ['Staff Scheduling & Compliance', 'Workforce planning, attendance, and reporting in one connected system.'],
];
---

<Layout title="Hospitals & Healthcare Solutions" description="1420 Solutions helps healthcare providers implement ERPNext for patient-facing operations, billing, inventory, and compliance.">
  <div class="space-y-12 px-6 py-8 sm:px-8 lg:px-10 lg:py-10">
    <HeroSection
      eyebrow="Hospitals & healthcare solutions"
      title="Manage patient operations, billing, and compliance without losing control."
      subheadline="1420 Solutions configures ERPNext around the realities of healthcare operations so billing, inventory, scheduling, and reporting become easier to manage."
      ctaHref="/contact"
      ctaLabel="Request a demo"
    />

    <section class="rounded-3xl border border-stone-200 bg-white p-8 shadow-sm dark:border-stone-700 dark:bg-stone-900 sm:p-10 lg:p-12">
      <SectionHeading title="Key challenges we solve" intro="Healthcare organizations need systems that support both patient-facing service and back-office discipline." />
      <ul class="mt-8 grid gap-4 md:grid-cols-2">
        {challenges.map((item) => (
          <li class="rounded-2xl border border-stone-200 bg-slate-50 p-5 text-sm leading-7 text-stone-700 dark:border-stone-700 dark:bg-stone-950 dark:text-stone-300">{item}</li>
        ))}
      </ul>
    </section>

    <section class="rounded-3xl border border-stone-200 bg-gradient-to-br from-slate-50 to-sky-50 p-8 shadow-sm dark:border-stone-700 dark:bg-stone-900 sm:p-10 lg:p-12">
      <SectionHeading title="What we implement" intro="We shape the operational setup around the needs of care delivery, finance, and compliance rather than forcing a generic process model." />
      <div class="mt-8 grid gap-6 md:grid-cols-2">
        {modules.map(([title, body]) => (
          <div class="rounded-2xl border border-stone-200 bg-white p-6 dark:border-stone-700 dark:bg-stone-950">
            <h3 class="text-lg font-semibold">{title}</h3>
            <p class="mt-2 text-sm leading-7 text-stone-600 dark:text-stone-300">{body}</p>
          </div>
        ))}
      </div>
    </section>

    <CtaSection title="Need a more reliable operating setup for healthcare administration?" href="/contact" label="Book a free consultation" />
  </div>
</Layout>
