---
import Layout from "@layouts/default.astro";
import HeroSection from "@components/marketing/hero-section.astro";
import SectionHeading from "@components/marketing/section-heading.astro";
import IndustryCard from "@components/marketing/industry-card.astro";
import ServiceCard from "@components/marketing/service-card.astro";
import CtaSection from "@components/marketing/cta-section.astro";
import { themeConfig } from '~/theme.config';

const locale = themeConfig.i18n.defaultLocale;

const industries = [
  { title: 'Education', description: 'Admissions, fees, and staff HR in one system for schools and training providers.', href: '/industries/education', tag: 'ERPNext Education' },
  { title: 'Hospitality', description: 'Reservations, housekeeping, and inventory in sync across properties and teams.', href: '/industries/hospitality', tag: 'Multi-property operations' },
  { title: 'Gym & Fitness', description: 'Memberships, scheduling, and billing on autopilot for growing clubs.', href: '/industries/gym-fitness', tag: 'Membership management' },
  { title: 'Manufacturing', description: 'Production planning, BOMs, and supply chain visibility under one roof.', href: '/industries/manufacturing', tag: 'Production control' },
  { title: 'Real Estate & Construction', description: 'Projects, budgets, and vendors tracked end to end from site to close.', href: '/industries/real-estate-construction', tag: 'Project delivery' },
  { title: 'Hospitals & Healthcare', description: 'Patient records, billing, and compliance handled with operational clarity.', href: '/industries/healthcare', tag: 'Healthcare operations' },
];

const services = [
  { title: 'ERP Implementation', description: 'Deploy and customize ERPNext around your workflows with migration, training, and support.', href: '/services/erp-implementation', icon: 'heroicons:computer-desktop' },
  { title: 'Custom Software Development', description: 'Build internal tools and integrations that ERPNext cannot cover out of the box.', href: '/services/custom-software', icon: 'heroicons:wrench-screwdriver' },
  { title: 'AI Solutions', description: 'Automate document processing, forecasting, and routine operations with practical AI.', href: '/services/ai-solutions', icon: 'heroicons:sparkles' },
  { title: 'Data Analysis & Reporting', description: 'Turn operational data into board-ready quarterly and yearly business insight.', href: '/services/data-analysis-reporting', icon: 'heroicons:chart-bar' },
];
---

<Layout title="1420 Solutions | ERPNext, Custom Software, and AI Solutions" description="1420 Solutions helps organizations implement and extend ERPNext with custom software, AI tools, and data reporting across education, hospitality, gyms, manufacturing, real estate, and healthcare." header={{ overlay: false }} noTitleSlug noContainer>
  <div class="space-y-16 px-6 pt-24 pb-8 sm:px-8 sm:pt-28 lg:px-10 lg:pt-32 lg:pb-10">
    <HeroSection
      eyebrow="ERPNext implementation · custom software · AI solutions"
      title="Your operations are unique. Your ERP should be too."
      subheadline="1420 Solutions implements and customizes ERPNext for education, hospitality, gyms, manufacturing, real estate, and healthcare businesses — then extends it with custom software, AI tools, and data-driven reporting that generic ERP vendors don't offer."
      ctaHref="/contact"
      ctaLabel="Book a free consultation"
      secondaryHref="/solutions"
      secondaryLabel="See our industries"
    />

    <section class="rounded-3xl border border-stone-200 bg-white p-8 shadow-sm dark:border-stone-700 dark:bg-stone-900 sm:p-10 lg:p-12">
      <SectionHeading eyebrow="One partner, four capabilities" title="More than an ERP vendor" intro="Most ERP consultants stop at installation. We go further — building the systems, software, and intelligence your business actually runs on." />
      <div class="mt-10 grid gap-6 md:grid-cols-2 xl:grid-cols-4">
        {services.map((service) => (
          <ServiceCard title={service.title} description={service.description} href={service.href} icon={service.icon} />
        ))}
      </div>
    </section>

    <section class="rounded-3xl border border-stone-200 bg-white p-8 shadow-sm dark:border-stone-700 dark:bg-stone-900 sm:p-10 lg:p-12">
      <SectionHeading eyebrow="Built for your industry" title="ERP that speaks your language" intro="We shape each deployment around the way your industry actually operates instead of handing you a generic ERP install." />
      <div class="mt-10 grid gap-6 md:grid-cols-2 xl:grid-cols-3">
        {industries.map((industry) => (
          <IndustryCard title={industry.title} description={industry.description} href={industry.href} tag={industry.tag} />
        ))}
      </div>
      <div class="mt-8">
        <a href="/industries" class="font-semibold text-sky-700 dark:text-sky-300">See all industries and services</a>
      </div>
    </section>

    <section class="rounded-3xl border border-slate-200 bg-slate-50 p-8 shadow-sm dark:border-slate-700 dark:bg-slate-900 sm:p-10 lg:p-12">
      <SectionHeading title="Why businesses choose 1420 Solutions" intro="We build on ERPNext, work in your industry language, and stay after launch to help the system keep delivering value." />
      <div class="mt-8 grid gap-6 md:grid-cols-2">
        <div class="rounded-2xl border border-slate-200 bg-white p-6 dark:border-slate-700 dark:bg-slate-950">
          <h3 class="text-lg font-semibold text-slate-900 dark:text-white">We build on ERPNext</h3>
          <p class="mt-2 text-sm leading-7 text-slate-600 dark:text-slate-300">A proven, flexible platform that gives you room to grow without locking you into a rigid black-box experience.</p>
        </div>
        <div class="rounded-2xl border border-slate-200 bg-white p-6 dark:border-slate-700 dark:bg-slate-950">
          <h3 class="text-lg font-semibold text-slate-900 dark:text-white">We speak your industry</h3>
          <p class="mt-2 text-sm leading-7 text-slate-600 dark:text-slate-300">Implementations are shaped around actual workflows, approvals, reporting needs, and service realities.</p>
        </div>
        <div class="rounded-2xl border border-slate-200 bg-white p-6 dark:border-slate-700 dark:bg-slate-950">
          <h3 class="text-lg font-semibold text-slate-900 dark:text-white">We don't stop at ERP</h3>
          <p class="mt-2 text-sm leading-7 text-slate-600 dark:text-slate-300">Custom software and AI fill the gaps off-the-shelf systems leave behind.</p>
        </div>
        <div class="rounded-2xl border border-slate-200 bg-white p-6 dark:border-slate-700 dark:bg-slate-950">
          <h3 class="text-lg font-semibold text-slate-900 dark:text-white">We stay after launch</h3>
          <p class="mt-2 text-sm leading-7 text-slate-600 dark:text-slate-300">Support, training, and quarterly reporting keep the system working for you long after go-live.</p>
        </div>
      </div>
    </section>

    <section class="rounded-3xl border border-stone-200 bg-white p-8 shadow-sm dark:border-stone-700 dark:bg-stone-900 sm:p-10 lg:p-12">
      <SectionHeading title="How we work" intro="We move from discovery through rollout and long-term support with a clear process built around your operation." />
      <div class="mt-10 grid gap-6 lg:grid-cols-5">
        {[
          ['Discovery', 'We map your workflows, pain points, and reporting needs.'],
          ['Selection & Scoping', 'We define which ERPNext modules and custom builds fit your needs.'],
          ['Implementation', 'We configure, migrate data, and integrate your systems.'],
          ['Training', 'Your team learns the system hands-on, not just from a manual.'],
          ['Support & Reporting', 'We keep the system running and turn data into practical decisions.'],
        ].map(([title, body]) => (
          <div class="rounded-2xl border border-stone-200 bg-slate-50 p-6 dark:border-stone-700 dark:bg-stone-950">
            <p class="text-sm font-semibold uppercase tracking-[0.2em] text-sky-700 dark:text-sky-300">{title}</p>
            <p class="mt-3 text-sm leading-7 text-stone-600 dark:text-stone-300">{body}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="rounded-3xl border border-stone-200 bg-white p-8 shadow-sm dark:border-stone-700 dark:bg-stone-900 sm:p-10 lg:p-12">
      <SectionHeading title="Trusted by teams across industries" intro="Client logos and testimonials will be added here as real references become available." />
    </section>

    <CtaSection title="Let's build the system your business actually needs" body="Tell us about your operation — we'll show you what ERPNext, customized and extended by 1420 Solutions, can do for you." href="/contact" label="Book a free consultation" />
  </div>
</Layout>
